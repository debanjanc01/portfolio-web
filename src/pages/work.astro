---
import BaseLayout from "../layouts/Base.astro";
import { getCollection } from 'astro:content';

const projects = (await getCollection('work'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<BaseLayout
  title="Work — Debanjan"
  description="Production work on reliability and messaging systems, plus selected side projects."
>
  <div class="eyebrow">Work</div>
  <hr class="rule" />
  <h1>Work</h1>
  <p class="lede">Production systems first — reliability, accounting, and cost under real load. Side projects below.</p>

  <section class="section" style="margin-top:28px">
    <div class="section-label">Production</div>

    <article class="card">
      <div class="work-head">
        <h3 style="margin:0">Message accounting end-to-end</h3>
        <span class="tag">reliability</span>
      </div>
      <p style="margin:8px 0 12px">
        Outbound platform across Email, SMS, App, and WhatsApp. Source and target counts didn't reconcile — false drops poisoned every investigation. Segregated stage metrics and eliminated logging artifacts until message counts accounted 100% source-to-target.
      </p>
      <p class="linkline" style="margin:0">
        <a href="/writing/message-accounting">note →</a>
        · <a href="/timeline">timeline →</a>
      </p>
    </article>

    <article class="card">
      <div class="work-head">
        <h3 style="margin:0">Cost, quality, and retry storms</h3>
        <span class="tag">operations</span>
      </div>
      <p style="margin:8px 0 12px">
        Cut AWS cost ~21% by removing network and disk-IO bottlenecks; lifted SonarQube quality metrics 78% across microservices; redesigned WhatsApp as a bot-of-bots. Separate incident path: a slow Aerospike shard turned into an outage when synchronized retries amplified the load — fixed with skip-bad-keys, backoff, and jitter.
      </p>
      <p class="linkline" style="margin:0">
        <a href="/writing/aerospike-retry-storm">retry storm note →</a>
        · <a href="/timeline">timeline →</a>
      </p>
    </article>
  </section>

  {projects.length > 0 && (
    <section class="section">
      <div class="section-label">Side projects</div>
      <div style="margin-top:8px">
        {projects.map((p) => (
          <article class="card side-card">
            <div class="work-head">
              <h3 style="margin:0;font-size:1.05rem">
                {p.data.repo ? (
                  <a href={p.data.repo} target="_blank" rel="noreferrer">{p.data.title}</a>
                ) : p.data.title}
              </h3>
              <span class="tag">{p.data.kind}</span>
            </div>
            <p style="margin:8px 0 0;font-size:0.95rem">{p.data.summary}</p>
            {(p.data.repo || p.data.demo) && (
              <p class="linkline" style="margin:10px 0 0">
                {p.data.repo && <a href={p.data.repo} target="_blank" rel="noreferrer">repo ↗</a>}
                {p.data.demo && <> · <a href={p.data.demo} target="_blank" rel="noreferrer">demo ↗</a></>}
              </p>
            )}
          </article>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .work-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .card h3 a { border: 0; }
  .card h3 a:hover { border-bottom: 1px solid var(--ink); }
  .side-card { padding: 14px 16px; margin: 10px 0; }
</style>
