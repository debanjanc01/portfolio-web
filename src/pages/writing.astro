---
import BaseLayout from "../layouts/Base.astro";
import { getCollection } from 'astro:content';

const all = (await getCollection('writing')).filter((e) => !e.data.draft);
const byRecency = (a, b) => {
  const ad = a.data.date ? a.data.date.getTime() : 0;
  const bd = b.data.date ? b.data.date.getTime() : 0;
  if (ad !== bd) return bd - ad;
  return (b.data.order ?? 0) - (a.data.order ?? 0);
};

const notes = all.filter((e) => e.data.kind === 'note').sort(byRecency);
const external = all
  .filter((e) => e.data.kind !== 'note')
  .sort(byRecency);

const modeLabel = (mode) => {
  const map = {
    dive: 'deep dive',
    lesson: 'lesson',
    career: 'career',
    human: 'human',
    philosophy: 'philosophy',
    building: 'building',
  };
  return mode ? map[mode] ?? mode : 'note';
};

const fmtDate = (d?: Date) =>
  d ? `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}` : '';
---

<BaseLayout
  title="Writing - Debanjan"
  description="Notes on production failures, judgment under pressure, early-career questions, and why building still matters."
>
  <div class="eyebrow">Writing</div>
  <hr class="rule" />
  <h1>Writing</h1>
  <p class="lede">
    Long notes live here. Outages, people, career, philosophy. The short version is on
    <a href="https://x.com/theybanjan" target="_blank" rel="noreferrer">@theybanjan</a>.
    Tool roundups from other sites sit at the bottom. They're not the point of this page.
  </p>

  {notes.length > 0 && (
    <section class="section" style="margin-top:28px">
      <div class="section-label">Notes</div>
      <div class="posts">
        {notes.map((e) => (
          <a class="post-card" href={`/writing/${e.slug}`}>
            <div class="post-head">
              <span>{modeLabel(e.data.mode)}</span>
              <span>{fmtDate(e.data.date)}</span>
            </div>
            <p style="margin:0 0 6px;color:var(--ink);font-weight:500">{e.data.title}</p>
            {e.data.hook && <p class="post-hook">{e.data.hook}</p>}
          </a>
        ))}
      </div>
    </section>
  )}

  {external.length > 0 && (
    <section class="section">
      <div class="section-label">Elsewhere (external)</div>
      <p class="external-note">Comparisons and list pieces I wrote for other sites. Useful. Not the main story.</p>
      <div class="rows">
        {external.map((e) => (
          <div class="row">
            <span class="row-left">
              <span class="tag">{e.data.kind}</span>
              {e.data.url ? (
                <a class="row-title" href={e.data.url} target="_blank" rel="noreferrer">{e.data.title}</a>
              ) : (
                <a class="row-title" href={`/writing/${e.slug}`}>{e.data.title}</a>
              )}
            </span>
            <span class="row-meta">{[e.data.source, e.data.date ? fmtDate(e.data.date) : null].filter(Boolean).join(' · ')}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  <p class="linkline" style="margin-top:40px">
    <a href="/rss.xml">RSS</a>
    · <a href="https://x.com/theybanjan" target="_blank" rel="noreferrer">@theybanjan</a>
    · <a href="https://geekflare.com/author/debanjan/" target="_blank" rel="noreferrer">Geekflare</a>
  </p>
</BaseLayout>

<style>
  .row-left { display: flex; align-items: baseline; min-width: 0; }
  a.post-card { display: block; color: inherit; border: 0; text-decoration: none; }
  a.post-card:hover { border-color: var(--ink-muted); }
  .external-note {
    margin: 0 0 10px;
    font-size: 0.92rem;
    color: var(--ink-muted);
    max-width: 36em;
  }
</style>
