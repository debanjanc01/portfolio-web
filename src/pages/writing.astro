---
import BaseLayout from "../layouts/Base.astro";
import { getCollection } from 'astro:content';

const all = (await getCollection('writing')).filter((e) => !e.data.draft);
const byRecency = (a, b) => {
  const ad = a.data.date ? a.data.date.getTime() : 0;
  const bd = b.data.date ? b.data.date.getTime() : 0;
  if (ad !== bd) return bd - ad;
  return (b.data.order ?? 0) - (a.data.order ?? 0);
};

const notes = all.filter((e) => e.data.kind === 'note').sort(byRecency);
const external = all
  .filter((e) => e.data.kind !== 'note')
  .sort(byRecency);

const fmtDate = (d?: Date) =>
  d ? `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}` : '';
---

<BaseLayout
  title="Writing - Debanjan"
  description="Longer notes by Debanjan Choudhury. Short takes are on X. The professional version is on LinkedIn."
>
  <h1>Writing</h1>
  <p class="intro-quiet">
    The longer pieces. Short takes and brain dumps are on
    <a href="https://x.com/theybanjan" target="_blank" rel="noreferrer">X</a>.
    The polished professional version is on
    <a href="https://www.linkedin.com/in/debanjanc01" target="_blank" rel="noreferrer">LinkedIn</a>.
  </p>

  {notes.length > 0 && (
    <ul class="notes">
      {notes.map((e) => (
        <li>
          <a class="note-link" href={`/writing/${e.slug}`}>
            <span class="note-date">{fmtDate(e.data.date)}</span>
            <span class="note-title">{e.data.title}</span>
            {e.data.hook && <span class="note-hook">{e.data.hook}</span>}
          </a>
        </li>
      ))}
    </ul>
  )}

  {external.length > 0 && (
    <section class="section">
      <h2>Other sites</h2>
      <p class="external-note">Pieces I wrote for other sites.</p>
      <ul class="notes">
        {external.map((e) => (
          <li>
            <a class="note-link" href={e.data.url ?? `/writing/${e.slug}`} target={e.data.url ? '_blank' : undefined} rel={e.data.url ? 'noreferrer' : undefined}>
              <span class="note-date">{e.data.source ?? fmtDate(e.data.date)}</span>
              <span class="note-title">{e.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <p style="margin-top:36px">
    <a href="/rss.xml">RSS</a>
  </p>
</BaseLayout>

<style>
  .intro-quiet { color: var(--ink-muted); max-width: 36em; margin-top: 0; }
  .external-note {
    margin: 0;
    color: var(--ink-muted);
    max-width: 36em;
  }
</style>
