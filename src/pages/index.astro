---
import BaseLayout from "../layouts/Base.astro";
import { getCollection } from 'astro:content';

const notes = (await getCollection('writing'))
  .filter((e) => !e.data.draft && e.data.kind === 'note' && !e.data.url)
  .sort((a, b) => {
    const ad = a.data.date ? a.data.date.getTime() : 0;
    const bd = b.data.date ? b.data.date.getTime() : 0;
    if (ad !== bd) return bd - ad;
    return (b.data.order ?? 0) - (a.data.order ?? 0);
  });

const fmtDate = (d) =>
  d ? `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}` : '';
---

<BaseLayout
  title="Debanjan — Senior Software Engineer"
  description="Senior software engineer at Apollo.io. Backend systems, production reliability, and writing about how designs behave after they ship."
  ogImage="/og-image.png"
>
  <section class="hero">
    <h1>I build backend systems that stay honest under load.</h1>
    <p class="lede">Production is where a design becomes visible. I work on email deliverability and sequences at Apollo.io, and write about failures, observability, and the operational judgment that keeps systems trustworthy.</p>
  </section>

  {notes.length > 0 && (
    <section class="section">
      <div class="section-label">Writing</div>
      <div class="posts">
        {notes.map((n) => (
          <a class="post-card" href={`/writing/${n.slug}`}>
            <div class="post-head">
              <span>note</span>
              <span>{fmtDate(n.data.date)}</span>
            </div>
            <p style="margin:0 0 6px;color:var(--ink);font-weight:500">{n.data.title}</p>
            {n.data.hook && <p class="post-hook">{n.data.hook}</p>}
          </a>
        ))}
      </div>
      <p style="margin-top:14px"><a href="/writing">All writing →</a></p>
    </section>
  )}

  <section class="section">
    <div class="section-label">Proof</div>
    <p style="max-width:36em;margin:0">
      At Snapdeal: 100% source-to-target message accounting, ~21% AWS cost cut, WhatsApp bot-of-bots redesign, SonarQube +78%.
      Notes on <a href="/writing/message-accounting">counting messages</a> and <a href="/writing/aerospike-retry-storm">retry storms</a> — full path on the <a href="/timeline">timeline</a>.
    </p>
  </section>

  <section class="section">
    <p class="linkline">
      <a href="mailto:debanjanc01@gmail.com">debanjanc01@gmail.com</a>
      · <a href="/writing">writing</a>
      · <a href="/contact">contact</a>
    </p>
  </section>
</BaseLayout>

<style>
  a.post-card { display: block; color: inherit; border: 0; text-decoration: none; }
  a.post-card:hover { border-color: var(--ink-muted); }
</style>
