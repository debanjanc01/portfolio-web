---
import BaseLayout from "../layouts/Base.astro";
import { getCollection } from 'astro:content';

const notes = (await getCollection('writing'))
  .filter((e) => !e.data.draft && e.data.kind === 'note' && !e.data.url)
  .sort((a, b) => {
    const ad = a.data.date ? a.data.date.getTime() : 0;
    const bd = b.data.date ? b.data.date.getTime() : 0;
    if (ad !== bd) return bd - ad;
    return (b.data.order ?? 0) - (a.data.order ?? 0);
  });

const fmtDate = (d) =>
  d ? `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}` : '';
---

<BaseLayout
  title="Debanjan Choudhury"
  description="Debanjan Choudhury, tech lead at Apollo. He likes it when someone uses his code and never learns his name. Sequences, mailboxes, agents. Long writing here. Short takes on X."
  ogImage="/og-image.png"
>
  <h1>Debanjan Choudhury</h1>
  <p class="intro">
    Tech lead at Apollo. I like it when someone uses my code and never learns my name. A sequence they sent. The mailbox it left from. Before that, a notification, a WhatsApp message, or the chat agent at Snapdeal. These days agents can do the Apollo part from a chat, and I'm still delighted by that.
  </p>
  <p class="intro-quiet">
    This site is where a thought goes once I've sat with it. The messier first pass is a short take on
    <a href="https://x.com/theybanjan" target="_blank" rel="noreferrer">X</a>.
    The polished professional version is on
    <a href="https://www.linkedin.com/in/debanjanc01" target="_blank" rel="noreferrer">LinkedIn</a>.
  </p>

  {notes.length > 0 && (
    <ul class="notes">
      {notes.map((n) => (
        <li>
          <a class="note-link" href={`/writing/${n.slug}`}>
            <span class="note-date">{fmtDate(n.data.date)}</span>
            <span class="note-title">{n.data.title}</span>
            {n.data.hook && <span class="note-hook">{n.data.hook}</span>}
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>

<style>
  .intro {
    font-size: 1.125rem;
    color: var(--ink);
    max-width: 36em;
    margin: 0 0 10px;
  }
  .intro-quiet {
    color: var(--ink-muted);
    max-width: 36em;
    margin: 0;
  }
</style>
